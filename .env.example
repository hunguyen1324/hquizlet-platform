# ── Payment Service (SePay) ──────────────────────────────────────
# File service: use minio for local storage, r2 for Cloudflare R2.
STORAGE_PROVIDER=minio
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public domain required for file service images (not private teacher videos).
R2_PUBLIC_URL=
# Optional jurisdiction-specific S3 endpoint; otherwise derived from account ID.
R2_ENDPOINT=
STORAGE_PRESIGN_TTL_MINS=15

# Independent data-server backup (MinIO remains primary).
BACKUP_PROVIDER=r2
BACKUP_ENABLED=false
BACKUP_PREFIX=hquizlet-backup
# Generate each once, keep offline; changing these makes old backups unreadable.
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_ENCRYPTION_SALT=
BACKUP_MAX_STORAGE_BYTES=9500000000
BACKUP_INTERVAL_SECONDS=900
BACKUP_BWLIMIT=5M
BACKUP_TPSLIMIT=10
# Empty = STORAGE_BUCKET + MINIO_IMPORT_BUCKET. imports/ is excluded.
BACKUP_SOURCE_BUCKETS=

# Primary PostgreSQL remains local. Neon is only a separate snapshot backup target.
NEON_BACKUP_ENABLED=false
NEON_BACKUP_URL=
# POSTGRES_URL is also accepted as a backup-only alias; never replace DATABASE_URL.
NEON_BACKUP_INTERVAL_SECONDS=86400
NEON_BACKUP_RETRY_SECONDS=1800
NEON_BACKUP_KEEP=2
NEON_BACKUP_TIMEOUT_SECONDS=7200

# SePay API token from https://my.sepay.vn
SEPAY_API_TOKEN=

# Bank account ID from SePay (find at my.sepay.vn → Bank Accounts)
SEPAY_BIDV_BANK_ACCOUNT_ID=

# Virtual account number (VA) used in SePay QR, e.g. 96247FYY64
SEPAY_VA_ACCOUNT_NUMBER=

# Webhook API key from SePay (my.sepay.vn → Settings → Webhook)
SEPAY_WEBHOOK_API_KEY=

# Optional: override SePay API base URL (default: https://userapi.sepay.vn/v2)
# SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2

# Optional: restrict webhook IP to SePay servers
# SEPAY_ALLOWED_IPS=45.124.94.15

# Content protection (study service). See docs/content-protection-audit.md
WATERMARK_SECRET=change-me-long-random
CONTENT_MAX_PAGE_SIZE=20
CONTENT_REQUESTS_PER_MIN=60
CONTENT_CARDS_PER_WINDOW=300
CONTENT_CARD_WINDOW_SECONDS=600
CONTENT_BULK_ENFORCEMENT_ENABLED=false

# Internal HMAC Signing Key (Task 2)
INTERNAL_SIGNING_KEY=change-me-long-random-internal-signing-key
