# HQuizlet Platform – Environment Variables Example
# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env vào git

# ── Gateway ──────────────────────────
PORT=8080
AUTH_SERVICE_URL=http://localhost:8081
STUDY_SERVICE_URL=http://localhost:8082
QUIZ_SERVICE_URL=http://localhost:8083

# ── Auth Service ──────────────────────
# PORT=8081   (set trong từng service)
JWT_SECRET=your-very-secret-key-change-in-production
SESSION_TTL=3600

# ── Database (shared) ─────────────────
DATABASE_URL=postgres://hquizlet:hquizlet@localhost:5432/hquizlet?sslmode=disable

# ── Frontend ──────────────────────────
VITE_GATEWAY_URL=http://localhost:8080
