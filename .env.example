[TEMPLATE]
# ============================================
# HQuizlet Platform — Local Docker Environment
# Không commit file này lên Git
# ============================================

# Gateway
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://auth:8081
STUDY_SERVICE_URL=http://study:8082
QUIZ_SERVICE_URL=http://quiz:8083

# Auth Service
AUTH_PORT=8081

# Go time.Duration:
# 1h = 1 giờ, 24h = 1 ngày, 720h = 30 ngày
SESSION_TTL=1h

# Hiện tại Auth dùng session PostgreSQL, JWT_SECRET chưa được code sử dụng
JWT_SECRET=dev-secret-change-in-prod

# Study Service
STUDY_PORT=8082

# Quiz Service
QUIZ_PORT=8083

# PostgreSQL
POSTGRES_DB=hquizlet
POSTGRES_USER=hquizlet
POSTGRES_PASSWORD=hquizlet
POSTGRES_PORT=5432

# Host là "postgres" khi chạy bên trong Docker Compose
DATABASE_URL=postgres://hquizlet:hquizlet@postgres:5432/hquizlet?sslmode=disable

# Frontend
WEB_PORT=5173
VITE_GATEWAY_URL=http://localhost:8080

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# NATS
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://nats:4222

# Payment Service
PAYMENT_PORT=8085
PAYMENT_SERVICE_URL=http://payment:8085

# Admin token for manual wallet operations
ADMIN_TOKEN=dev-admin-token

# SePay Payment Gateway
# Lay tai my.sepay.vn → API → Token
SEPAY_API_TOKEN=

# UUID cua tai khoan BIDV tren SePay (Company → Bank accounts → ID)
SEPAY_BIDV_BANK_ACCOUNT_ID=

# API Key de SePay xac thuc khi gui webhook den he thong
# Lay tai my.sepay.vn → Webhooks → API Key
SEPAY_WEBHOOK_API_KEY=

# (Optional) Ghi de base URL cho sandbox/dev
# De trong = dung production: https://userapi.sepay.vn/v2
# Sandbox: https://userapi-sandbox.sepay.vn/v2
SEPAY_API_BASE_URL=
