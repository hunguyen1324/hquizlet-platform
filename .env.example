# ── Payment Service (SePay) ──────────────────────────────────────
# SePay API token from https://my.sepay.vn
SEPAY_API_TOKEN=

# Bank account ID from SePay (find at my.sepay.vn → Bank Accounts)
SEPAY_BIDV_BANK_ACCOUNT_ID=

# Virtual account number (VA) used in SePay QR, e.g. 96247FYY64
SEPAY_VA_ACCOUNT_NUMBER=

# Webhook API key from SePay (my.sepay.vn → Settings → Webhook)
SEPAY_WEBHOOK_API_KEY=

# Optional: override SePay API base URL (default: https://userapi.sepay.vn/v2)
# SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2

# Optional: restrict webhook IP to SePay servers
# SEPAY_ALLOWED_IPS=45.124.94.15

# Content protection (study service). See docs/content-protection-audit.md
WATERMARK_SECRET=change-me-long-random
CONTENT_MAX_PAGE_SIZE=20
CONTENT_REQUESTS_PER_MIN=60
CONTENT_CARDS_PER_WINDOW=300
CONTENT_CARD_WINDOW_SECONDS=600
CONTENT_BULK_ENFORCEMENT_ENABLED=false
