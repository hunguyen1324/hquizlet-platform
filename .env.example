# ============================================
# HQuizlet Platform — Local Docker Environment
# Copy this file to .env and fill in values
# ============================================

# Gateway
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://auth:8081
STUDY_SERVICE_URL=http://study:8082
QUIZ_SERVICE_URL=http://quiz:8083
CLASS_SERVICE_URL=http://class:8084
PAYMENT_SERVICE_URL=http://payment:8085
FILE_SERVICE_URL=http://file:8086

# Auth Service
AUTH_PORT=8081
SESSION_TTL=1h
JWT_SECRET=dev-secret-change-in-prod

# Study Service
STUDY_PORT=8082

# Quiz Service
QUIZ_PORT=8083

# Class Service
CLASS_PORT=8084

# Payment Service
PAYMENT_PORT=8085
ADMIN_TOKEN=dev-admin-token

# File Service (Phase 9)
FILE_PORT=8086

# PostgreSQL
POSTGRES_DB=hquizlet
POSTGRES_USER=hquizlet
POSTGRES_PASSWORD=hquizlet
POSTGRES_PORT=5432
DATABASE_URL=postgres://hquizlet:hquizlet@postgres:5432/hquizlet?sslmode=disable

# Frontend
WEB_PORT=5173
VITE_GATEWAY_URL=http://localhost:8080

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# NATS
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://nats:4222

# Storage (MinIO dev / S3 prod / Cloudflare R2)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=hquizlet
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/hquizlet
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true

# MinIO root credentials (docker-compose dev only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# SePay Payment Gateway
SEPAY_API_TOKEN='YXCVEAQUXXFGY7DIVMJSABF32NOZCDU9NA65WBESLOLKMNDSHPQFGRFUB8HHUPLW'
SEPAY_BIDV_BANK_ACCOUNT_ID='3057c98f-96b9-11f1-b21a-a6006ab65aca'
SEPAY_WEBHOOK_API_KEY='b621e8e0dcd730ed2513c7e6b42f17c1'
SEPAY_API_BASE_URL=''


