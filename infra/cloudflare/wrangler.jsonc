{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hquizlet",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/files", "/files/*"]
  }
}
